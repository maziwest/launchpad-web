# Copy to .env (devnet) or .env.mainnet (mainnet build) and fill in.
# Build for mainnet with: npm run build -- --mode mainnet
# Never commit real values: .env and .env.* are git-ignored.

# "mainnet" or "devnet"
VITE_NETWORK=mainnet
# Public RPC URL used by the browser. Use a dedicated frontend key, it is visible to every visitor.
VITE_RPC_ENDPOINT=YOUR_FRONTEND_RPC_URL
# Meteora DBC config key that new launches use (the platform config)
VITE_DBC_CONFIG_KEY=YOUR_PLATFORM_CONFIG_KEY
# Config key and mint of the official $MQ token (leave the mint empty until it launches)
VITE_MQ_CONFIG_KEY=YOUR_MQ_CONFIG_KEY
VITE_MQ_MINT=
# Public wallet addresses (not secrets)
VITE_BUYBACK_WALLET=YOUR_BUYBACK_WALLET_ADDRESS
VITE_ADMIN_WALLET=YOUR_PLATFORM_WALLET_ADDRESS
# Base URL of the Minti Q backend API
VITE_API_BASE_URL=https://api.example.com
# Only used by local node scripts, never by the site (keep this one private)
HELIUS_RPC=YOUR_PRIVATE_RPC_URL
VITE_PROGRAM_ID=REPLACE_ME
VITE_PLATFORM_FEE_VAULT=REPLACE_ME
